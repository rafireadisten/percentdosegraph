# JWT Secret
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Supabase Auth
# Set these to enable Supabase-backed registration, login, and bearer token validation.
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-or-anon-key
SUPABASE_AUTH_EMAIL_REDIRECT_TO=http://localhost:8080/frontend-react/

# SMART on FHIR / EHR integration
# Enable the live EHR connection layer only where you explicitly want it exposed.
ENABLE_FHIR_SMART=false
ENABLE_CUSTOM_FHIR_EHR=false
ALLOWED_APP_ORIGINS=http://localhost:8080,https://percentdosegraph.pages.dev,https://dosegraph.io,https://www.dosegraph.io
APP_BASE_URL=https://dosegraph.io

# Google OAuth (optional)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Database URL (optional, for PostgreSQL)
# DATABASE_URL=postgresql://user:pass@localhost:5432/dbname
